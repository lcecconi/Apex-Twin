# Assistant & Agent Local Storage
.brain/
.gemini/
.claude/

# PlatformIO & Embedded Build Artifacts
**/.pio/
**/.pioenvs/
**/.piolibdeps/
*.elf
*.bin
*.hex
*.o
*.obj
*.a
*.d
*.map

# Editor & IDE Directories
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Python Caches & Virtual Environments
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Large Component Datasheets & 3D Model Binaries
