apex-dash/refs/datasheets/*.pdf
apex-dash/refs/datasheets/*.rar
apex-dash/refs/datasheets/*.zip
apex-dash/refs/datasheets/*.step
apex-dash/refs/datasheets/*.stl

# Runtime Telemetry Logs & Dumps
*.log
**/logs/*.csv
**/logs/*.log
session_dumps/